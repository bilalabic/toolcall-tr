# Bu dosyayı .env olarak kopyalayın. .env asla versiyon kontrolüne girmez.
#
# TEMEL KURAL: kimlik bilgisi execution altyapısına aittir, eğitim verisine
# değil. Hiçbir anahtar JSONL'e, cassette'e, observation'a veya loga yazılmaz.
#
# M1'de HİÇBİRİ ZORUNLU DEĞİLDİR: testler ve pipeline cassette + StubClient ile
# API anahtarı olmadan uçtan uca çalışır.

# Türkçe paraphrase üretimi ve (M2) judge için.
# configs/generation.yaml -> llm.provider: openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # uyumlu bir proxy kullanılıyorsa

# İsteğe bağlı. Tanımlanırsa judge farklı bir SAĞLAYICIDAN seçilebilir ve
# self-preference bias tam olarak elenir. Boş bırakılabilir; bu durumda judge
# da OpenAI tarafındadır ve bu sınırlama dataset card'da belirtilir.
ANTHROPIC_API_KEY=

# Cassette modu: replay | record | record_missing
# Varsayılan ve CI: replay. record yalnızca kasıtlı yeniden kayıt içindir.
TOOLCALL_TR_CASSETTE_MODE=replay
